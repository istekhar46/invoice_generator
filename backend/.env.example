# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# Enable SSL connection
PG_SSL=true

# Self-signed CA certificate for Aiven (paste as a single line, replace newlines with \n)
PG_CA_CERT="-----BEGIN CERTIFICATE-----\nMIIBIjANBgkq...\n-----END CERTIFICATE-----"

# SSL certificate verification (set to 'false' for Aiven PostgreSQL or other managed DBs with self-signed certs)
# When 'true' (default) and PG_CA_CERT is set, it will verify the certificate chain
PG_SSL_REJECT_UNAUTHORIZED=true

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Application Configuration
PORT=8001
NODE_ENV=development

# Rate Limiting Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS Configuration
FRONTEND_URL="http://localhost:5173"

# Cookie Configuration (for refresh tokens)
# COOKIE_DOMAIN - Domain for the cookie (optional, defaults to current domain)
# COOKIE_DOMAIN=".example.com"
COOKIE_PATH="/api/v1/auth/refresh"
COOKIE_SECURE="false"  # Set to "true" in production (HTTPS only)
COOKIE_SAME_SITE="strict"  # Options: "strict", "lax", "none"
COOKIE_MAX_AGE="604800000"  # 7 days in milliseconds

# API Server Configuration for Swagger Documentation
API_DEV_SERVER_URL="http://localhost:8001"
API_PROD_SERVER_URL="https://api.example.com"