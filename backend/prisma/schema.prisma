// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model for authentication
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String
  passwordHash String?
  photoURL    String?
  googleId    String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  companyProfile CompanyProfile?
  customers      Customer[]
  invoices       Invoice[]
  quotes         Quote[]
  documentCounters DocumentCounter[]
  documentNumbers DocumentNumber[]
  refreshTokens  RefreshToken[]
  invoiceDefaults InvoiceDefaults?
  catalogItems    CatalogItem[]
  stockActions    StockAction[]
  paymentEntries  PaymentEntry[]
  razorpayConnections RazorpayConnection[]
  gatewayLinks GatewayLink[]
  gatewayPayments GatewayPayment[]
  gatewayRefunds GatewayRefund[]
  gatewayLinkRequests GatewayLinkRequest[]
  
  @@map("users")
}

// One account's reusable settings; invoice records keep their own snapshots.
model InvoiceDefaults {
  userId       String @id
  currency     String
  taxRate      Float
  paymentTerms String
  notes        String
  terms        String
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoice_defaults")
}

// Refresh token model for secure token management
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Indexes for query optimization
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Company profile model
model CompanyProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  businessName     String
  address          String
  city             String
  state            String
  zipCode          String
  phone            String
  email            String
  taxNumber        String
  defaultLaborRate Float
  defaultTaxRate   Float
  logoUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("company_profiles")
}

// Customer model
model Customer {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String
  phone     String
  address   String
  city      String
  state     String
  zipCode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  quotes   Quote[]
  
  // Indexes for query optimization
  @@index([userId])
  @@index([name])
  @@index([email])
  @@index([createdAt])
  @@map("customers")
}

// Invoice model
model Invoice {
  id            String        @id @default(cuid())
  userId        String
  customerId    String?
  clientRequestId String?
  invoiceNumber String
  serviceDate   DateTime
  dueDate       DateTime
  subtotal      Float
  taxRate       Float
  taxAmount     Float
  total         Float
  notes         String?
  currency      String @default("USD")
  discountType  String @default("percentage")
  discountValue Float @default(0)
  shippingAmount Float @default(0)
  amountPaid    Float @default(0)
  paymentTerms  String?
  terms         String?
  purchaseOrderNumber String?
  shippingAddress String?
  logoDataUrl    String?
  status        InvoiceStatus @default(DRAFT)
  // Unknown for historical issued invoices; set only on future explicit issue.
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Inline company details for quick invoices (optional)
  quickCompanyName    String?
  quickCompanyAddress String?
  quickCompanyCity    String?
  quickCompanyState   String?
  quickCompanyZipCode String?
  quickCompanyPhone   String?
  quickCompanyEmail   String?
  quickCompanyTaxNumber String?

  // Inline customer details for quick invoices (optional)
  quickCustomerName    String?
  quickCustomerEmail   String?
  quickCustomerPhone   String?
  quickCustomerAddress String?
  quickCustomerCity    String?
  quickCustomerState   String?
  quickCustomerZipCode String?

  // Flag to identify quick invoices
  isQuickInvoice Boolean @default(false)
  sourceQuoteId String?

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceQuote Quote? @relation(fields: [userId, sourceQuoteId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  customer  Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lineItems LineItem[]
  stockActions StockAction[]
  paymentEntries PaymentEntry[]
  gatewayLinks GatewayLink[]
  gatewayPayments GatewayPayment[]
  gatewayRefunds GatewayRefund[]

  publicShare InvoiceShare?

  // Indexes for query optimization
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([serviceDate])
  @@index([createdAt])
  @@index([userId, status])
  @@index([userId, customerId])
  @@unique([userId, clientRequestId])
  @@unique([userId, invoiceNumber])
  @@unique([userId, id])
  @@unique([userId, sourceQuoteId])
  @@index([isQuickInvoice])
  @@map("invoices")
}

// Active public capability; revocation deletes the mapping without changing the invoice.
model InvoiceShare {
  id        String   @id @db.VarChar(43)
  userId    String
  invoiceId String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, invoiceId])
  @@map("invoice_shares")
}

// Line item model
model LineItem {
  id          String       @id @default(cuid())
  invoiceId   String
  type        LineItemType
  description String
  unit        String       @default("")
  quantity    Float
  rate        Float
  amount      Float
  catalogItemId String?
  
  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)
  
  // Indexes for query optimization
  @@index([invoiceId])
  @@index([type])
  @@index([catalogItemId])
  @@map("line_items")
}

// Enums
enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOIDED
}

enum PaymentEntryKind {
  OPENING
  UPI
  REVERSAL
  RAZORPAY
  REFUND
}

enum RazorpayMode {
  TEST
  LIVE
}

// One business's direct merchant credentials, isolated between provider modes.
model RazorpayConnection {
  id                   String @id @default(cuid())
  userId               String
  mode                 RazorpayMode
  encryptedCredentials String
  keySuffix            String @db.VarChar(4)
  enabled              Boolean @default(true)
  version              Int @default(1)
  webhookCiphertext    String?
  validatedAt          DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  links                GatewayLink[]
  webhookEvents        GatewayWebhookEvent[]
  webhookSecrets       GatewayWebhookSecret[]

  @@unique([userId, mode])
  @@unique([userId, id, mode])
  @@map("razorpay_connections")
}

// Amounts are signed integer currency minor units; history is append-only.
model PaymentEntry {
  id            String @id @default(cuid())
  sequence      BigInt @unique @default(autoincrement())
  userId        String
  invoiceId     String
  requestId     String
  requestHash   String?
  kind          PaymentEntryKind
  amountMinor   BigInt
  currency      String
  openingSource String?
  openingKey    String?
  paymentDate   DateTime? @db.Date
  reference     String?
  notes         String @default("")
  reversalOfId  String?
  gatewayPaymentId String?
  gatewayRefundId String?
  createdAt     DateTime @default(now())
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice       Invoice @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: NoAction, onUpdate: Restrict)
  reversalOf    PaymentEntry? @relation("PaymentReversal", fields: [userId, invoiceId, reversalOfId], references: [userId, invoiceId, id], onDelete: NoAction, onUpdate: Restrict)
  reversal      PaymentEntry? @relation("PaymentReversal")
  gatewayPayment GatewayPayment? @relation(fields: [userId, invoiceId, gatewayPaymentId], references: [userId, invoiceId, id], onDelete: NoAction, onUpdate: Restrict)
  gatewayRefund GatewayRefund? @relation(fields: [userId, invoiceId, gatewayRefundId], references: [userId, invoiceId, id], onDelete: NoAction, onUpdate: Restrict)

  @@unique([userId, requestId])
  @@unique([userId, openingKey])
  @@unique([userId, invoiceId, id])
  @@unique([userId, invoiceId, reversalOfId])
  @@unique([userId, invoiceId, gatewayPaymentId])
  @@unique([userId, invoiceId, gatewayRefundId])
  @@index([userId, sequence])
  @@index([userId, invoiceId, sequence])
  @@index([userId, paymentDate])
  @@map("payment_entries")
}

enum GatewayLinkState {
  PENDING
  ACTIVE
  UNKNOWN
  CANCELLING
  PAID
  CANCELLED
  EXPIRED
  FAILED
}

model GatewayLink {
  id String @id @default(cuid())
  userId String
  invoiceId String
  connectionId String
  mode RazorpayMode
  referenceId String @unique @db.VarChar(40)
  amountMinor BigInt
  activeKey String?
  state GatewayLinkState @default(PENDING)
  providerId String?
  orderId String?
  url String?
  lastError String?
  createAttemptedAt DateTime?
  synchronizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: NoAction, onUpdate: Restrict)
  connection RazorpayConnection @relation(fields: [userId, connectionId, mode], references: [userId, id, mode], onDelete: NoAction, onUpdate: Restrict)
  payments GatewayPayment[]
  requests GatewayLinkRequest[]
  @@unique([userId, id])
  @@unique([userId, activeKey])
  @@unique([connectionId, providerId])
  @@unique([userId, invoiceId, id, connectionId])
  @@index([userId, mode, createdAt])
  @@index([userId, invoiceId, createdAt])
  @@index([connectionId, orderId])
  @@map("gateway_links")
}

// Every accepted create request replays its original link, including reuse aliases.
model GatewayLinkRequest {
  userId String
  requestId String @db.VarChar(100)
  linkId String
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  link GatewayLink @relation(fields:[userId,linkId],references:[userId,id],onDelete:NoAction,onUpdate:Restrict)
  @@id([userId,requestId])
  @@map("gateway_link_requests")
}

// Provider capture facts remain separate from invoice-applied ledger amounts.
model GatewayPayment {
  id String @id @default(cuid())
  userId String
  invoiceId String
  linkId String
  connectionId String
  providerId String
  receivedMinor BigInt
  appliedMinor BigInt
  currency String @db.VarChar(3)
  method String @db.VarChar(32)
  exception String?
  providerCreatedAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: NoAction, onUpdate: Restrict)
  link GatewayLink @relation(fields: [userId, invoiceId, linkId, connectionId], references: [userId, invoiceId, id, connectionId], onDelete: NoAction, onUpdate: Restrict)
  refunds GatewayRefund[]
  entry PaymentEntry?
  @@unique([connectionId, providerId])
  @@unique([userId, invoiceId, id])
  @@index([userId, invoiceId, createdAt])
  @@map("gateway_payments")
}

model GatewayRefund {
  id String @id @default(cuid())
  userId String
  invoiceId String
  paymentId String
  connectionId String
  providerId String
  amountMinor BigInt
  appliedMinor BigInt @default(0)
  status String @db.VarChar(16)
  providerCreatedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: NoAction, onUpdate: Restrict)
  payment GatewayPayment @relation(fields: [userId, invoiceId, paymentId], references: [userId, invoiceId, id], onDelete: NoAction, onUpdate: Restrict)
  entry PaymentEntry?
  @@unique([connectionId, providerId])
  @@unique([userId, invoiceId, id])
  @@map("gateway_refunds")
}

model GatewayWebhookEvent {
  id String @id @default(cuid())
  connectionId String
  providerEventId String @db.VarChar(200)
  digest String @db.Char(64)
  event String @db.VarChar(100)
  outcome String @db.VarChar(16)
  createdAt DateTime @default(now())
  connection RazorpayConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  @@unique([connectionId, providerEventId])
  @@map("gateway_webhook_events")
}

// Retired secrets remain valid only through the provider's 24-hour retry window.
model GatewayWebhookSecret {
  id String @id @default(cuid())
  connectionId String
  ciphertext String
  expiresAt DateTime
  connection RazorpayConnection @relation(fields:[connectionId],references:[id],onDelete:Cascade)
  @@index([connectionId, expiresAt])
  @@map("gateway_webhook_secrets")
}

enum LineItemType {
  PRODUCT
  SERVICE
}

// Reusable defaults; invoices retain their own line-item snapshots.
model CatalogItem {
  id          String       @id @default(cuid())
  userId      String
  type        LineItemType
  name        String
  description String       @default("")
  sku         String?
  unit        String
  rate        Float
  currency    String
  isArchived  Boolean      @default(false)
  usedAt      DateTime?
  // Null means untracked. Enabling tracking and opening history are atomic.
  stockTrackingStartedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineItems   LineItem[]
  quoteLineItems QuoteLineItem[]
  stockActions StockAction[]
  stockMovements StockMovement[]

  @@unique([userId, sku])
  @@unique([userId, id])
  @@index([userId, isArchived, name])
  @@map("catalog_items")
}

// An immutable owner action groups movements and records retries even with no delta.
// Additional source/append-only invariants: prisma/constraints/inventory.sql.
model StockAction {
  id            String @id @default(cuid())
  sequence      BigInt @unique @default(autoincrement())
  userId        String
  requestId     String @db.VarChar(100)
  requestHash   String @db.Char(64)
  kind          StockActionKind
  sourceKey     String? @db.VarChar(160)
  catalogItemId String?
  invoiceId     String?
  reversalOfId  String?
  reason        String @db.VarChar(500)
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now())

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  catalogItem CatalogItem? @relation(fields: [userId, catalogItemId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  invoice     Invoice? @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  reversalOf  StockAction? @relation("StockActionReversal", fields: [userId, reversalOfId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  reversal    StockAction? @relation("StockActionReversal")
  movements   StockMovement[]

  @@unique([userId, id])
  @@unique([userId, requestId])
  @@unique([userId, sourceKey])
  @@unique([userId, reversalOfId])
  @@index([userId, sequence])
  @@index([userId, catalogItemId])
  @@index([userId, invoiceId])
  @@map("stock_actions")
}

// The ledger sum is authoritative; no independently editable balance cache.
model StockMovement {
  id            String @id @default(cuid())
  userId        String
  actionId      String
  catalogItemId String
  quantityDelta Decimal @db.Decimal(18, 3)

  action      StockAction @relation(fields: [userId, actionId], references: [userId, id], onDelete: Cascade, onUpdate: NoAction)
  catalogItem CatalogItem @relation(fields: [userId, catalogItemId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([actionId, catalogItemId])
  @@index([userId, catalogItemId])
  @@map("stock_movements")
}

enum StockActionKind {
  OPENING
  ADJUSTMENT
  INVOICE_ISSUE
  INVOICE_EDIT
  INVOICE_VOID
}

// Account sequences serialize automatic and manually numbered document creation.
model DocumentCounter {
  userId String
  kind String
  value BigInt @default(0)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, kind])
  @@map("document_counters")
}

enum QuoteStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DECLINED
  CANCELLED
}

model Quote {
  id String @id @default(cuid())
  userId String
  customerId String
  clientRequestId String @db.VarChar(100)
  requestHash String @db.Char(64)
  quoteNumber String
  status QuoteStatus @default(DRAFT)
  version Int @default(1)
  quoteDate DateTime @db.Date
  validUntil DateTime @db.Date
  issuedAt DateTime?
  acceptedAt DateTime?
  companySnapshot Json
  customerSnapshot Json
  logoDataUrl String @default("")
  currency String
  discountType String @default("percentage")
  discountValue Float @default(0)
  shippingAmount Float @default(0)
  subtotal Float
  taxRate Float
  taxAmount Float
  total Float
  paymentTerms String @default("")
  notes String @default("")
  terms String @default("")
  purchaseOrderNumber String @default("")
  shippingAddress String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lineItems QuoteLineItem[]
  convertedInvoice Invoice?
  @@unique([userId, id])
  @@unique([userId, quoteNumber])
  @@unique([userId, clientRequestId])
  @@index([userId, status, createdAt])
  @@map("quotes")
}

model QuoteLineItem {
  id String @id @default(cuid())
  userId String
  quoteId String
  position Int
  type LineItemType
  catalogItemId String?
  description String
  unit String
  quantity Float
  rate Float
  amount Float
  quote Quote @relation(fields: [userId, quoteId], references: [userId, id], onDelete: Cascade)
  catalogItem CatalogItem? @relation(fields: [userId, catalogItemId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([quoteId, position])
  @@index([userId, catalogItemId])
  @@map("quote_line_items")
}

// Retained after document deletion/renumbering so no other document can reuse a number.
model DocumentNumber {
  userId String
  kind String
  number String
  documentId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, kind, number])
  @@map("document_numbers")
}
